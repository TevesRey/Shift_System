# Add each of these in Vercel -> Project -> Settings -> Environment Variables
# (Production). NEVER commit real values.

APP_NAME=ShiftMate
APP_ENV=production
APP_DEBUG=false
# Generate with:  php artisan key:generate --show
APP_KEY=
# Your final URL, e.g. https://shiftmate-system.vercel.app (update after first deploy)
APP_URL=https://YOUR-PROJECT.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Hosted MySQL 8 (127.0.0.1 will NOT work on Vercel)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Most hosted MySQL providers require TLS. Common CA bundle path inside the image:
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Profile photos: container disk is wiped, see DEPLOY_VERCEL.md (optional S3 step)
FILESYSTEM_DISK=public

# Schedule-update emails (Gmail needs an App Password)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ShiftMate
MAIL_TIMEOUT=8

# First admin account (used by: php artisan db:seed). Must be unique & strong.
SHIFTMATE_ADMIN_NAME=ShiftMate Administrator
SHIFTMATE_ADMIN_EMAIL=
SHIFTMATE_ADMIN_PASSWORD=
SHIFT_MATE_ADMIN_REGISTRATION_CODE=
